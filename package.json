{
  "name": "tymer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "start": "pnpm run dev",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sounds": "uv run --directory build-tools/tts sounds.py",
    "sounds:generate": "uv run --directory build-tools/tts sounds.py generate",
    "sounds:promote": "uv run --directory build-tools/tts sounds.py promote",
    "sounds:manifest": "node build-tools/generate-sound-manifest.js",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:css": "stylelint 'src/**/*.scss'",
    "lint:css:fix": "stylelint 'src/**/*.scss' --fix",
    "lint:sh": "shellcheck -x combine_all_sounds.sh normalize_audio.sh build-tools/audio-presets.sh build-tools/preview-audio-preset.sh build-tools/tts/completions/*.bash",
    "lint:py": "uv run --directory build-tools/tts ruff check",
    "format:py": "uv run --directory build-tools/tts ruff format",
    "format:py:check": "uv run --directory build-tools/tts ruff format --check",
    "knip": "knip",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@preact/signals": "^2.11.1",
    "date-fns": "^4.4.0",
    "howler": "^2.2.4",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.2.0",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.0.1",
    "knip": "6.32.2",
    "lint-staged": "17.3.0",
    "postcss": "^8.5.26",
    "postcss-csso": "^6.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-sh": "0.19.0",
    "sass": "^1.103.1",
    "simple-git-hooks": "2.13.1",
    "stylelint": "17.14.1",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-plugin-use-baseline": "1.4.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  },
  "browserslist": [
    ">= 0.5%",
    "last 2 major versions",
    "not dead",
    "Chrome >= 60",
    "Firefox >= 60",
    "Firefox ESR",
    "iOS >= 12",
    "Safari >= 12",
    "not Explorer <= 11",
    "not op_mini all"
  ]
}
