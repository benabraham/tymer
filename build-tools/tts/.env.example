# Copy to .env and fill in. Get a key at https://aistudio.google.com/apikey
#
# The free tier is roughly 15 TTS requests per day and 3 per minute, per
# account. A full set is 36 clips, so one key cannot generate a whole set in a
# day. Add keys from additional Google accounts and the tool moves on to the
# next one automatically when a key runs dry — their daily quotas add up.

GEMINI_API_KEY=your_key_here

# Optional, any number of them:
# GEMINI_API_KEY_2=second_account_key
# GEMINI_API_KEY_3=third_account_key

# Or as one comma-separated list instead:
# GEMINI_API_KEYS=key_one,key_two,key_three
