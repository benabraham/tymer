# Copy to .env and fill in. Get keys at https://aistudio.google.com/apikey
#
# GEMINI_API_KEYS is a list — separate entries with commas, whitespace or
# newlines. Add as many as you like; there is no fixed number.
#
# Quota is per Google Cloud project, so keys created under DIFFERENT Google
# accounts have entirely separate budgets and genuinely add up. Two keys from
# the same project share one budget and buy nothing.
#
# The free tier is roughly 15 TTS requests/day and 3/minute per account, against
# 36 clips per set. Requests are spread across the keys round-robin, and a key
# is dropped for the rest of the run after 3 rate limits or a spent daily quota.

GEMINI_API_KEYS=first_key,second_key,third_key

# A single key can also be given on its own (combined with the list if both are set):
# GEMINI_API_KEY=only_key
