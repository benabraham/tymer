# Prettier runs over the whole repo (`pnpm run format` is just `prettier .`), so
# THIS file defines the scope — not a glob in package.json. That was the previous
# design and it silently left every .scss file unformatted for as long as the
# stylesheets had existed, because `css` in a brace list does not match `scss`.
# An ignore file fails safe in the other direction: a new file type gets
# formatted until someone decides otherwise.

node_modules
dist
coverage
.direnv

# Vite's dependency-optimizer cache. Note it is currently TRACKED by git and
# absent from .gitignore, which is its own bug — this entry only keeps Prettier
# from rewriting a build artefact in the meantime.
.vite

# Resolver output, not a document: pnpm regenerates it wholesale, and a
# reformatted lockfile would conflict on every install. Never hand-edit.
pnpm-lock.yaml

# Generated by build-tools/generate-sound-manifest.js — reformatting it here
# would be reverted on the next regeneration.
src/lib/sound-manifest.ts
