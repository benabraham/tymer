{
    "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": false },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on",
                "useSortedInterfaceMembers": "on"
            }
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "correctness": {
                "noUnusedVariables": "error",
                "useHookAtTopLevel": "error",
                "useExhaustiveDependencies": "warn"
            },
            "style": {
                "noNonNullAssertion": "warn",
                "noParameterAssign": "error",
                "useConsistentArrowReturn": "error"
            },
            "complexity": {
                "noUselessUndefined": "error",
                "useOptionalChain": "error"
            },
            "suspicious": {
                "noDeprecatedImports": "error",
                "noDuplicateDependencies": "error",
                "noExplicitAny": "error",
                "noImportCycles": "error",
                "noUnusedExpressions": "error"
            },
            "a11y": {
                "useButtonType": "warn",
                "noPositiveTabindex": "warn",
                "noStaticElementInteractions": "warn",
                "useKeyWithClickEvents": "warn",
                "noNoninteractiveTabindex": "warn"
            }
        }
    },
    "formatter": {
        "enabled": false,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100,
        "lineEnding": "lf"
    },
    "javascript": {
        "formatter": {
            "semicolons": "asNeeded",
            "quoteStyle": "single",
            "jsxQuoteStyle": "double",
            "trailingCommas": "all",
            "arrowParentheses": "asNeeded",
            "bracketSpacing": true
        }
    },
    "files": {
        "includes": [
            "**/*.ts",
            "**/*.tsx",
            "**/*.js",
            "**/*.json",
            "!**/node_modules",
            "!**/dist",
            "!**/coverage",
            "!**/.vite",
            "!**/pnpm-lock.yaml",
            "!build-tools/tts/.venv",
            "!src/lib/sound-manifest.ts"
        ]
    },
    "overrides": [
        {
            "includes": ["package.json", "vite.config.js"],
            "formatter": { "indentWidth": 2 }
        },
        {
            "includes": ["**/*.test.ts", "**/*.test.tsx"],
            "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } }
        }
    ]
}
